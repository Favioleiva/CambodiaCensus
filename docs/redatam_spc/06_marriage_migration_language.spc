* ==============================================================================
* Geo4Cambodia v5 — 2019 Census (Camb.dic): Marriage Age, Migration & Languages
* ==============================================================================
RUNDEF Marriage_Migration_Lang_2019
    SELECTION ALL

TABLE T_MEAN_MARRIAGE_AGE_SEX
    AS AREABREAK COMMUNE.ID
    AVERAGE OF PERSON.P08_MARRIAGE_AGE BY PERSON.P04_SEX1
    FOR PERSON.P05_AGE1 >= 15 AND PERSON.P07_MARITAL >= 2 AND PERSON.P08_MARRIAGE_AGE >= 10 AND PERSON.P08_MARRIAGE_AGE <= 90

TABLE T_MOTHER_TONGUE
    AS FREQUENCY OF COMMUNE.ID BY PERSON.P09_M_TONGUE

TABLE T_FOREIGN_LITERACY_15P
    AS FREQUENCY OF COMMUNE.ID BY PERSON.P15B_LITERACY_OTHER
    FOR PERSON.P05_AGE1 >= 15

TABLE T_MIGRATION_POB
    AS FREQUENCY OF COMMUNE.ID BY PERSON.P11_PRO

TABLE T_MIGRATION_REASON
    AS FREQUENCY OF COMMUNE.ID BY PERSON.P14_MIGRATION
