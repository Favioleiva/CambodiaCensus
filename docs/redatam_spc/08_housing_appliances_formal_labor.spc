* ==============================================================================
* Geo4Cambodia v5 — 2019 Census (Camb.dic): Housing Quality, Appliances & Labor
* ==============================================================================
RUNDEF Housing_Labor_2019
    SELECTION ALL

TABLE T_ROOMS
    AS FREQUENCY OF COMMUNE.ID BY HOUSEHOLD.H08_ROOMS
    FOR HOUSEHOLD.C8_HHTYPE = 1

TABLE T_KITCHEN
    AS FREQUENCY OF COMMUNE.ID BY HOUSEHOLD.H09_KITCHEN
    FOR HOUSEHOLD.C8_HHTYPE = 1

TABLE T_TOILET_SHARE
    AS CROSSTABS OF COMMUNE.ID BY HOUSEHOLD.H04_TOILET_TYPE BY HOUSEHOLD.H05_TOILET_SHARE
    FOR HOUSEHOLD.C8_HHTYPE = 1

TABLE T_EMP_STATUS_15P
    AS FREQUENCY OF COMMUNE.ID BY PERSON.P20_EMP_STATUS
    FOR PERSON.P05_AGE1 >= 15 AND PERSON.P18_ACTIVITY = 1

TABLE T_EMP_SECTOR_15P
    AS FREQUENCY OF COMMUNE.ID BY PERSON.P22_EMP_SECTOR
    FOR PERSON.P05_AGE1 >= 15 AND PERSON.P18_ACTIVITY = 1

TABLE T_INACTIVITY_15P
    AS FREQUENCY OF COMMUNE.ID BY PERSON.P18_ACTIVITY
    FOR PERSON.P05_AGE1 >= 15
