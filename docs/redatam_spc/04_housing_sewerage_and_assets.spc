* ==============================================================================
* Geo4Cambodia v4 — 2019 Census (Camb.dic): Housing, Sewerage Network & Assets
* Regular households only (HOUSEHOLD.C8_HHTYPE = 1)
* ==============================================================================
RUNDEF Housing_Assets_2019
    SELECTION ALL

TABLE T_TENURE
    AS FREQUENCY OF COMMUNE.ID BY HOUSEHOLD.H01_DWELLING
    FOR HOUSEHOLD.C8_HHTYPE = 1

TABLE T_LIGHTING
    AS FREQUENCY OF COMMUNE.ID BY HOUSEHOLD.H02_LIGHT
    FOR HOUSEHOLD.C8_HHTYPE = 1

TABLE T_COOKING_FUEL
    AS FREQUENCY OF COMMUNE.ID BY HOUSEHOLD.H03_FUEL
    FOR HOUSEHOLD.C8_HHTYPE = 1

TABLE T_TOILET_SEWERAGE
    AS FREQUENCY OF COMMUNE.ID BY HOUSEHOLD.H04_TOILET_TYPE
    FOR HOUSEHOLD.C8_HHTYPE = 1
* Code 2 = Connected to public sewerage network; Code 3 = Septic tank

TABLE T_DRINKING_WATER
    AS FREQUENCY OF COMMUNE.ID BY HOUSEHOLD.H06_WATER
    FOR HOUSEHOLD.C8_HHTYPE = 1

TABLE T_TRACTOR
    AS FREQUENCY OF COMMUNE.ID BY (HOUSEHOLD.H23A_TRACTOR > 0)
    FOR HOUSEHOLD.C8_HHTYPE = 1

TABLE T_KOYAON
    AS FREQUENCY OF COMMUNE.ID BY (HOUSEHOLD.H23B_KOYAON > 0)
    FOR HOUSEHOLD.C8_HHTYPE = 1

TABLE T_HOME_INTERNET
    AS FREQUENCY OF COMMUNE.ID BY HOUSEHOLD.H24_INTERNET_HOME
    FOR HOUSEHOLD.C8_HHTYPE = 1
