* ==============================================================================
* Geo4Cambodia v5 — 2019 Census (Camb.dic): Fertility, Maternal Care & Civil Reg
* ==============================================================================
RUNDEF Fertility_Mortality_2019
    SELECTION ALL

DEFINE PERSON.CEB_TOTAL AS (PERSON.F04A_CEB_M + PERSON.F04B_CEB_F)
    TYPE INTEGER

TABLE T_CEB_WOMEN_15_49
    AS AREABREAK COMMUNE.ID
    AVERAGE OF PERSON.CEB_TOTAL
    FOR PERSON.P04_SEX1 = 2 AND PERSON.P05_AGE1 >= 15 AND PERSON.P05_AGE1 <= 49

TABLE T_DELIVERY_ASSISTANCE
    AS FREQUENCY OF COMMUNE.ID BY PERSON.F08_ASSISTANCE
    FOR PERSON.P04_SEX1 = 2 AND PERSON.P05_AGE1 >= 15 AND PERSON.P05_AGE1 <= 49

TABLE T_BIRTH_REGISTERED
    AS FREQUENCY OF COMMUNE.ID BY PERSON.F09_REGISTERED

TABLE T_DEATH_REGISTERED
    AS FREQUENCY OF COMMUNE.ID BY DEATH_RECORD.D7_REGISTERED

TABLE T_DEATH_PLACE
    AS FREQUENCY OF COMMUNE.ID BY DEATH_RECORD.D8B_PLACE
